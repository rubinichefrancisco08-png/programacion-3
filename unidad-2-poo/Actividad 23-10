class Producto:
    def __init__(self, nombre, tipo, precio, stock):
        self.nombre = nombre
        self.tipo = tipo
        self.precio = precio
        self.__stock = 0
        self.set_stock(stock)

    def get_stock(self):
        return self.__stock

    def set_stock(self, nuevo_stock):
        if nuevo_stock >= 0:
            self.__stock = nuevo_stock
        else:
            print("Stock inválido")

    def mostrar_datos(self):
        print("Nombre:",self.nombre,"\nTipo:",self.tipo,"\nPrecio:",self.precio,"\nStock:",self.__stock,"\n ")

    def vender(self, cantidad):
        if cantidad <= 0:
            print("Cantidad invalida")
        elif cantidad <= self.__stock:
            self.__stock -= cantidad
            print("Venta realizada")
            print("Stock restante:",self.__stock)
        else:
            print("Stock insuficiente")
        print(" ")

    def reponer(self, cantidad):
         if cantidad > 0:
             self.__stock = self.__stock + cantidad
             print("Reposición realizada")
         else:
            print("Cantidad inválida")

class Alimento(Producto):
    def __init__(self, nombre, precio, stock, vencimiento):
       super().__init__(nombre, "Alimento", precio, stock)
       self.vencimiento = vencimiento

    def mostrar_vencimiento(self):
        print("Vto:",self.vencimiento)

class Electronico(Producto):
    def __init__(self, nombre, precio, stock, garantia):
        super().__init__(nombre,"Electronico",precio,stock)
        self.garantia_meses = garantia

    def mostrar_garantia(self):
        print("Garantia:", self.garantia_meses ,"meses")

# Actividad 1
producto = Producto("Arroz","Alimento",2000,8)

producto.vender(3)
print(producto.get_stock())
# Después de la venta quedan 5 unidades disponibles.

producto.vender(10)
print(producto.get_stock())
# No se realiza la venta porque se está intentando vender más unidades de las que hay.

producto.set_stock(-5)
print(producto.get_stock())
# El stock sigue siendo el mismo porque el programa no permite establecer valores negativos.

# Actividad 2
producto.reponer(5)
print(producto.get_stock())

producto.reponer(-2)
print(producto.get_stock())
# Al ingresar una cantidad negativa, no se modifica el stock porque no cumple con la condición del if.

# Actividad 3
leche = Alimento("Leche", 1500, 10, "30/10/2026")
leche.mostrar_datos()
leche.mostrar_vencimiento()
leche.vender(2)
leche.reponer(4)
print(leche.get_stock())

# El método reponer() está definido en la clase Producto, por eso no hace falta volver a escribirlo en Alimento.

# La clase Alimento puede utilizarlo porque hereda los métodos de Producto.

# reponer() suma nuevas unidades al stock disponible, mientras que set_stock() establece una cantidad específica y reemplaza el valor anterior.
